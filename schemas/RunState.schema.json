{
  "$defs": {
    "BudgetUsed": {
      "additionalProperties": false,
      "properties": {
        "steps": {
          "minimum": 0,
          "title": "Steps",
          "type": "integer"
        },
        "llm_calls": {
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "elapsed_seconds": {
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        }
      },
      "required": [
        "steps",
        "llm_calls",
        "tool_calls",
        "elapsed_seconds"
      ],
      "title": "BudgetUsed",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "CREATED",
        "PLANNING",
        "RUNNING",
        "VERIFYING",
        "COMPLETED",
        "WAITING_APPROVAL",
        "WAITING_REVIEW",
        "FAILED",
        "CANCELLED"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "plan_version": {
      "minimum": 1,
      "title": "Plan Version",
      "type": "integer"
    },
    "task_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
        "type": "string"
      },
      "title": "Task Ids",
      "type": "array"
    },
    "completed_task_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
        "type": "string"
      },
      "title": "Completed Task Ids",
      "type": "array"
    },
    "budget_used": {
      "$ref": "#/$defs/BudgetUsed"
    },
    "checkpoint_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Ref"
    },
    "final_result_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Result Ref"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "last_consistent_checkpoint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Consistent Checkpoint"
    },
    "state_version": {
      "default": 0,
      "minimum": 0,
      "title": "State Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "plan_version",
    "task_ids",
    "completed_task_ids",
    "budget_used",
    "updated_at"
  ],
  "title": "RunState",
  "type": "object"
}
