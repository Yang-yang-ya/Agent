{
  "$defs": {
    "RiskLevel": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "action_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Action Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Task Id",
      "type": "string"
    },
    "agent_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Agent Id",
      "type": "string"
    },
    "tool": {
      "pattern": "^[a-z][a-z0-9_.]{0,79}$",
      "title": "Tool",
      "type": "string"
    },
    "operation": {
      "pattern": "^[a-z][a-z0-9_.]{0,79}$",
      "title": "Operation",
      "type": "string"
    },
    "arguments": {
      "additionalProperties": true,
      "title": "Arguments",
      "type": "object"
    },
    "reason": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "action_id",
    "run_id",
    "task_id",
    "agent_id",
    "tool",
    "operation",
    "arguments",
    "reason",
    "risk_level",
    "created_at"
  ],
  "title": "ActionProposal",
  "type": "object"
}
